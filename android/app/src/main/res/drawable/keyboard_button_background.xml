<?xml version="1.0" encoding="utf-8"?>
<!-- Round, dark, outlined so the button reads on both light and dark Mac content. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/display_keyboard_button_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/display_keyboard_button_background" />
            <stroke
                android:width="1dp"
                android:color="@color/display_keyboard_button_stroke" />
        </shape>
    </item>
</ripple>

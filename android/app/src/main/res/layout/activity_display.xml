<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Sized to the stream's aspect ratio in code (letterboxed, centered). -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Invisible editor the soft keyboard types into (KeyboardBridge forwards it to the Mac). -->
    <com.achreftlili.sidecast.input.KeyboardInputView
        android:id="@+id/keyboardInput"
        android:layout_width="1px"
        android:layout_height="1px" />

    <!-- The Mac's pointer in trackpad mode (§7.3). Positioned with translationX/Y only (no layout
         pass per move); INVISIBLE rather than GONE for the same reason. Not a control: touches on
         it reach the Mac. -->
    <ImageView
        android:id="@+id/pointer"
        android:layout_width="24dp"
        android:layout_height="33dp"
        android:layout_gravity="top|start"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pointer"
        android:visibility="invisible" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/display_scrim" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/display_detail_text" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondaryAction"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@color/display_stats_background"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Shown while the Mac records from this phone's microphone; sits left of the floating buttons
         (margins set with the insets). Touches on it are held back from the Mac (PointerFilter). -->
    <TextView
        android:id="@+id/micIndicator"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.85"
        android:background="@drawable/mic_indicator_background"
        android:contentDescription="@string/mic_indicator_description"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:text="@string/mic_indicator"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_mic" />

    <!-- "Touch mode" / "Trackpad mode" for ~1.5 s after a toggle; announced by TalkBack. -->
    <TextView
        android:id="@+id/inputModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/display_label_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Touch <-> trackpad toggle, left of the keyboard button; same style and fading. -->
    <ImageButton
        android:id="@+id/inputModeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="68dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.5"
        android:background="@drawable/keyboard_button_background"
        android:contentDescription="@string/input_mode_touch_description"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_input_touch"
        android:visibility="gone" />

    <!-- Shown only while streaming; margins follow the cutout (and the IME when it is reported). -->
    <ImageButton
        android:id="@+id/keyboardButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:alpha="0.5"
        android:background="@drawable/keyboard_button_background"
        android:contentDescription="@string/keyboard_toggle"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_keyboard"
        android:tooltipText="@string/keyboard_toggle"
        android:visibility="gone" />
</FrameLayout>
